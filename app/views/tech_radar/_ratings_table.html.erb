<%# Paged like Redmine's own lists; the pagination links keep the chart's filters %>
<div class="tech-radar-ratings-table">
  <h3><%= t('tech_radar.evaluation.table.heading') %></h3>

  <% if table.count.zero? %>
    <p class="nodata"><%= l(:label_no_data) %></p>
  <% else %>
    <p class="tech-radar-ratings-summary"><%= t('tech_radar.evaluation.table.rating_count', count: table.count) %></p>
    <table class="list">
      <thead>
        <tr>
          <th><%= t('tech_radar.evaluation.table.person') %></th>
          <th><%= t('tech_radar.evaluation.table.technology') %></th>
          <th><%= t('tech_radar.evaluation.table.can') %></th>
          <th><%= t('tech_radar.evaluation.table.want') %></th>
          <th><%= t('tech_radar.evaluation.table.updated_on') %></th>
        </tr>
      </thead>
      <tbody>
        <% ratings.each do |rating| %>
          <tr class="<%= cycle('odd', 'even') %>">
            <td><%= rating.user.name %></td>
            <td><%= rating.technology.name %></td>
            <td><%= t("tech_radar.rate.can.#{rating.can_level}") %></td>
            <td><%= t("tech_radar.rate.want.#{rating.want_level}") %></td>
            <td><%= last_edited_on(rating) %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
    <span class="pagination"><%= pagination_links_full pages, table.count %></span>
  <% end %>
</div>
